{
	"productName": "Retold Remote",
	"version": "0.0.1",
	"identifier": "com.retold.remote-desktop",
	"build": {
		"frontendDist": "../web-app"
	},
	"app": {
		"security": {
			"csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: data: blob:; connect-src 'self' http: https: ws: wss:; img-src 'self' http: https: data: blob:; media-src 'self' http: https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'",
			"dangerousDisableAssetCspModification": true
		},
		"windows": [
			{
				"label": "main",
				"title": "Retold Remote",
				"width": 1280,
				"height": 800,
				"minWidth": 640,
				"minHeight": 480,
				"resizable": true,
				"fullscreen": false,
				"decorations": true,
				"transparent": false,
				"visible": true
			}
		],
		"withGlobalTauri": true
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["lib/**/*"]
	},
	"plugins": {
		"shell": {
			"open": true
		}
	}
}
