{
	"identifier": "default",
	"description": "Default capabilities for retold-remote-desktop",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-set-focus",
		"core:window:allow-set-fullscreen",
		"core:window:allow-toggle-maximize",
		"core:webview:default",
		"dialog:default",
		"dialog:allow-open",
		"shell:default",
		{
			"identifier": "shell:allow-spawn",
			"allow": [
				{
					"name": "run-retold-remote",
					"cmd": "retold-remote",
					"args": true,
					"sidecar": false
				},
				{
					"name": "run-mpv",
					"cmd": "mpv",
					"args": true,
					"sidecar": false
				},
				{
					"name": "run-node",
					"cmd": "node",
					"args": true,
					"sidecar": false
				}
			]
		},
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "run-retold-remote",
					"cmd": "retold-remote",
					"args": true,
					"sidecar": false
				},
				{
					"name": "run-mpv",
					"cmd": "mpv",
					"args": true,
					"sidecar": false
				},
				{
					"name": "run-node",
					"cmd": "node",
					"args": true,
					"sidecar": false
				}
			]
		},
		"store:default",
		"window-state:default"
	]
}
