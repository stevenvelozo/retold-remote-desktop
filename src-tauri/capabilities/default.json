{
	"identifier": "default",
	"description": "Default capabilities for retold-remote-desktop",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-set-focus",
		"core:window:allow-set-fullscreen",
		"core:window:allow-toggle-maximize",
		"core:webview:default",
		"dialog:default",
		"dialog:allow-open",
		"shell:default",
		"shell:allow-spawn",
		"shell:allow-execute",
		"store:default",
		"window-state:default"
	]
}
